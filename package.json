{
  "name": "remates-tfm",
  "version": "0.16.4",
  "private": true,
  "description": "Plataforma de remates de vehículos y especies de alto rendimiento",
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint src/",
    "test": "tsx --test src/lib/serialize.test.ts",
    "check": "tsc --noEmit && eslint src/",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "Maximiliano Faundez",
  "license": "ISC",
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.25.0",
    "next": "^16.3.8",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.19",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0"
  },
  "pnpm": {
    "overrides": {
      "micromatch": ">=4.0.8",
      "fast-glob": ">=3.3.2"
    }
  }
}
