{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.5-free",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "read": "allow",
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "git *": "allow",
      "pnpm *": "allow",
      "*": "ask"
    },
    "task": "allow",
    "external_directory": {
      "~/secrets/**": "deny",
      "*": "ask"
    },
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 10,
    "preserve_recent_tokens": 2000
  },
  "tool_output": {
    "max_lines": 100,
    "max_bytes": 4096
  },
  "attachment": {
    "image": {
      "max_width": 1000,
      "max_height": 1000
    }
  }
}
