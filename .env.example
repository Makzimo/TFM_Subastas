# ============================================================
# Variables de entorno - Plataforma de Remates
# Copiar a .env (local) y configurar en Vercel (producción).
# NUNCA commitear el archivo .env con valores reales.
# ============================================================

# --- Base de datos PostgreSQL ---
# Local (docker compose): postgresql://user:password@localhost:5432/remates
# Producción (Neon/Vercel Postgres): usar la connection string con SSL.
# Ejemplo Neon: postgresql://usuario:clave@ep-xxx.aws.neon.tech/remates?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/remates"

# --- Autenticación (NextAuth v5) ---
# Generar con: openssl rand -base64 32
AUTH_SECRET="generar-con-openssl-rand-base64-32"
# URL base pública del sitio. En producción: https://tu-dominio.vercel.app
AUTH_URL="http://localhost:3001"
# Necesario detrás de proxy/hosting (Vercel). Dejar en true en producción.
AUTH_TRUST_HOST="true"

# --- Compatibilidad NextAuth (v5 acepta ambos nombres) ---
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generar-con-openssl-rand-base64-32"

# --- Origen de desarrollo (solo LAN, opcional) ---
ALLOWED_DEV_ORIGIN="192.168.0.143"

# --- Seed (solo desarrollo / inicialización) ---
SEED_ADMIN_PASSWORD="cambiar-en-produccion"
SEED_MARTILLERO_PASSWORD="cambiar-en-produccion"
SEED_POSTOR_PASSWORD="cambiar-en-produccion"
